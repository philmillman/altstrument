{
  "name": "altstrument",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A directory of custom firmware and tools for music hardware.",
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/validate.ts --media=soft && astro build",
    "build:timings": "tsx scripts/validate.ts --media=soft && astro build --timings",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "tsx scripts/validate.ts",
    "metrics:fetch": "tsx scripts/metrics/fetch.ts",
    "metrics:publish": "tsx scripts/metrics/release.ts publish",
    "metrics:prune-assets": "tsx scripts/metrics/release.ts prune",
    "metrics:report": "tsx scripts/metrics/report.ts",
    "discover:candidates": "tsx .claude/skills/discover/candidates.ts",
    "astro": "astro",
    "icons": "tsx scripts/build-icons.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "fast-xml-parser": "5.11.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "takumi-js": "2.16.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "wrangler": "^4.150.0",
    "yaml": "^2.8.0"
  },
  "packageManager": "pnpm@10.8.1"
}
