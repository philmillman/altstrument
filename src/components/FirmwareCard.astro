---
import type { FirmwareItem } from '@/lib/catalog';
import { KIND_LABELS, DISTRIBUTION_LABELS } from '@/lib/labels';
import StatusBadge from './StatusBadge.astro';
import SourceBadge from './SourceBadge.astro';
import LicenseBadge from './LicenseBadge.astro';
import QualityBadge from './QualityBadge.astro';
import BrickWarning from './BrickWarning.astro';
import TagList from './TagList.astro';
import AuthorList from './AuthorList.astro';
import VersionTable from './VersionTable.astro';
import Badge from './Badge.astro';
import { youtubeId, youtubeThumb } from '@/lib/media';
interface Props { firmware: FirmwareItem }
const { firmware: fw } = Astro.props;
const d = fw.data;
// Same precedence as the firmware page: a video's thumbnail wins over the image.
const vid = d.video ? youtubeId(d.video.url) : undefined;
const thumb = vid ? { src: youtubeThumb(vid), cover: true } : d.image ? { src: d.image.url, cover: false } : undefined;
---
<article id={fw.slug} class="rounded border border-line bg-surface p-3 sm:p-4">
  <div class:list={[thumb && 'sm:flex sm:items-start sm:gap-4']}>
  {thumb && (
    <a href={fw.url} tabindex="-1" aria-hidden="true" class="mb-3 block w-full max-w-[16rem] shrink-0 overflow-hidden rounded border border-line bg-surface-2 sm:order-last sm:mb-0 sm:w-44">
      <img
        src={thumb.src}
        alt=""
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        class:list={['block aspect-video w-full', thumb.cover ? 'object-cover' : 'object-contain']}
      />
    </a>
  )}
  <div class="min-w-0 flex-1">
  <header class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <h3 class="text-lg"><a href={fw.url} class="no-underline hover:underline">{d.name}</a></h3>
    {d.kind === 'tool' && <span class="text-xs uppercase tracking-wide text-muted">{KIND_LABELS.tool}</span>}
  </header>
  <p class="mt-1 max-w-[68ch]">{d.summary}</p>
  <p class="mt-1 text-sm text-muted">by <AuthorList authors={d.authors} /></p>
  <div class="mt-2 flex flex-wrap items-center gap-1.5">
    {fw.pin !== undefined && <Badge tone="gray" plain title="Pinned to the top of this device's list">Pinned</Badge>}
    <StatusBadge status={d.status} />
    <SourceBadge status={d.source_status} />
    <LicenseBadge license={d.license} />
    <QualityBadge firmware={fw} />
  </div>
  {(d.distribution || d.requires_stock) && (
    <dl class="mt-2 grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-0.5 text-sm">
      {d.distribution && (<><dt class="text-muted">Distribution</dt><dd>{DISTRIBUTION_LABELS[d.distribution]}</dd></>)}
      {d.requires_stock && (<><dt class="text-muted">Requires stock</dt><dd class="mono [overflow-wrap:anywhere]">{d.requires_stock}</dd></>)}
    </dl>
  )}
  {d.brick_risk && <div class="mt-2"><BrickWarning compact /></div>}
  {d.tags.length > 0 && <div class="mt-2"><TagList tags={d.tags} /></div>}
  </div>
  </div>
  {fw.versions.length > 0 && (
    <div class="mt-3">
      <VersionTable versions={fw.versions} visible={3} moreHref={`${fw.url}#versions-h`} caption={`${d.name} version history`} />
    </div>
  )}
</article>
