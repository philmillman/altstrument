---
interface Props { id: string; title: string; href?: string }
const { id, title, href } = Astro.props;
---
<section aria-labelledby={id}>
  <h2 id={id} class="flex items-baseline justify-between gap-2 border-b border-line pb-1 text-lg">
    {title}
    {href && <a href={href} class="text-sm font-normal">All recent →</a>}
  </h2>
  {/* One row at every width: three shrinking columns from sm up; on phones it scrolls sideways so search stays near the top. */}
  <ol class="mt-3 grid auto-cols-[minmax(16rem,1fr)] grid-flow-col sm:auto-cols-[minmax(0,1fr)] gap-3 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <slot />
  </ol>
</section>
