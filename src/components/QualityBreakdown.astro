---
import type { FirmwareItem } from '@/lib/catalog';
import { PILLARS, PILLAR_LABELS, RATING_DESCRIPTIONS, RATING_LABELS, type Pillar, type Quality } from '@/lib/quality';
interface Rel { id: string; name: string; url: string }
interface Props {
  /** The entry page's entry. Omit for `variant="device"`. */
  firmware?: FirmwareItem;
  /**
   * "device": the body of the device page's collapsible Quality block, for a
   * shared-repo score: no heading, score line or entry notes.
   */
  variant?: 'entry' | 'device';
  /** The score to break down; defaults to the entry's. */
  quality?: Quality;
  /** Community links listed under Community; defaults to the entry's. */
  links?: { label: string; url: string }[];
  /** Display names for facts.parentId and facts.childIds (entries not in the catalog are skipped). */
  parent?: Rel;
  children?: Rel[];
  /** Snapshot date (ISO), when a metrics snapshot exists. */
  fetchedAt?: string;
  /** Names the primary device in notes. */
  deviceName: string;
  /** The primary device's manufacturer, for the first-party note. */
  manufacturer: string;
}
const { firmware: fw, variant = 'entry', parent, children = [], fetchedAt, deviceName, manufacturer } = Astro.props;
const q = (Astro.props.quality ?? fw?.quality)!;
const f = q.facts;
const entry = variant === 'entry';
// The numeric score and pillar values stay internal; pillars are shown as a bar and a word.
const strength = (v: number) => (v >= 2 / 3 ? 'Strong' : v >= 1 / 3 ? 'Moderate' : 'Low');
// Each pillar's bar and word take the color of its own strength; the rating line stays violet like the badges.
const STRENGTH_FG = { Strong: 'var(--green-fg)', Moderate: 'var(--blue-fg)', Low: 'var(--amber-fg)' } as const;
const BAR = 'var(--violet-fg)';

const n = (x: number) => (x >= 1000 ? `${(x / 1000).toFixed(x >= 10000 ? 0 : 1).replace(/\.0$/, '')}k` : String(x));
const int = (x: number) => x.toLocaleString('en-US');
const count = (x: number, one: string, many = `${one}s`) => `${int(x)} ${x === 1 ? one : many}`;
const known = <T,>(xs: (T | false | undefined | null)[]) => xs.filter((x): x is T => Boolean(x));

const facts: Record<Pillar, string[]> = {
  maturity: known([
    f.ageYears !== undefined && `${f.ageYears.toFixed(1)} years`,
    count(f.releases, 'release'),
    f.commits !== undefined && count(f.commits, 'commit'),
  ]),
  popularity: f.stars !== undefined ? known([`★ ${n(f.stars)}`, `${n(f.forks ?? 0)} forks`, f.watchers ? `${n(f.watchers)} watching` : undefined]) : [],
  vitality: f.archived
    ? ['Archived']
    : f.finished
      ? known(['Finished: quiet but established', f.lastActivity && `last activity ${f.lastActivity}`])
      : known([f.commitsLastYear !== undefined && `${count(f.commitsLastYear, 'commit')} last year`, f.lastActivity && `last activity ${f.lastActivity}`]),
  issues: known([
    f.issuesClosed !== undefined && `${int(f.issuesClosed)} closed / ${int(f.issuesOpen ?? 0)} open`,
    f.prsTotal !== undefined && f.prsTotal > 0 && `${int(f.prsMerged ?? 0)} of ${int(f.prsTotal)} PRs merged`,
  ]),
  derivatives: known([
    `${count(children.length, 'catalog entry', 'catalog entries')} ${children.length === 1 ? 'builds' : 'build'} on this`,
    f.usefulForks !== undefined && `${int(f.usefulForks)} active forks`,
  ]),
  community: known([
    f.contributors !== undefined && count(f.contributors, 'contributor'),
    f.busFactor !== undefined && `bus factor ${f.busFactor}`,
    f.discussions !== undefined && 'Discussions',
  ]),
};
const links = Astro.props.links ?? fw?.data.community ?? [];
---
<section class:list={[entry && 'mt-8', 'max-w-[68ch]']} aria-labelledby={entry ? 'quality-h' : undefined} aria-label={entry ? undefined : 'Quality breakdown'} data-quality-block>
  {entry && (
    <>
      <h2 id="quality-h" class="mb-2 text-lg">Quality</h2>
      {q.rating && (
        <p class="flex flex-wrap items-baseline gap-x-2">
          <span class="text-xl font-semibold" style={`color: ${BAR}`}>{RATING_LABELS[q.rating]}</span>
          <span class="text-muted">{RATING_DESCRIPTIONS[q.rating]}</span>
        </p>
      )}
    </>
  )}
  {entry && q.override && (
    <p class="mt-1 text-sm">Adjusted by hand{q.override.level === 'device' ? ` for every ${deviceName} entry` : ''}: {q.override.reason}</p>
  )}
  {entry && !q.override && q.firstParty && (
    <p class="mt-1 text-sm text-muted">Counts as first-party: an official project or one by {manufacturer}.</p>
  )}
  {entry && q.shared && (
    <p class="mt-1 text-sm text-muted">
      Scored at the device level: this entry lives in <a href={`https://github.com/${q.shared.repo}`} rel="noopener">{q.shared.repo}</a>{' '}
      with {q.shared.members - 1} other {deviceName} entries, so they share one rating for the repo and the device's community.
    </p>
  )}
  <ul class="mt-3 flex flex-col gap-3 text-sm">
    {PILLARS.map((p) => {
      const v = q.pillars[p];
      const pct = v === null ? 0 : Math.round(v * 100);
      const word = v === null ? 'No data' : strength(v);
      const fg = v === null ? undefined : STRENGTH_FG[strength(v)];
      return (
        <li>
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-medium" id={`q-${p}`}>{PILLAR_LABELS[p]}</span>
            <span class:list={['text-xs', !fg && 'text-muted']} style={fg && `color: ${fg}`}>{word}</span>
          </div>
          <div
            class:list={['mt-1 h-2 overflow-hidden rounded-sm border', v === null ? 'border-dashed border-line-strong bg-transparent' : 'border-line bg-surface-2']}
            aria-hidden="true"
          >
            {v !== null && <div class="h-full" style={`width: ${pct}%; background: ${fg}`}></div>}
          </div>
          <p class="mt-1 text-muted">
            {facts[p].length > 0 && facts[p].join(' · ')}
            {p === 'derivatives' && (parent || children.length > 0) && (
              <>
                {facts[p].length > 0 && <br />}
                {parent && <>Builds on <a href={parent.url}>{parent.name}</a>.</>}
                {children.length > 0 && (
                  <>{parent && ' '}Derived entries: {children.map((c, i) => <>{i > 0 && ', '}<a href={c.url}>{c.name}</a></>)}.</>
                )}
              </>
            )}
            {p === 'community' && links.length > 0 && (
              <>
                {facts[p].length > 0 && <br />}
                {links.map((l, i) => <>{i > 0 && ', '}<a href={l.url} rel="noopener">{l.label}</a></>)}
              </>
            )}
            {facts[p].length === 0 && !(p === 'derivatives' && (parent || children.length)) && !(p === 'community' && links.length) && <>No data.</>}
          </p>
        </li>
      );
    })}
  </ul>
  <p class="mt-3 text-xs text-muted">
    Data from GitHub{fetchedAt ? `, ${fetchedAt.slice(0, 10)}` : ' (no snapshot yet)'}. <a href="/about/quality">How ratings work</a>.
  </p>
</section>
