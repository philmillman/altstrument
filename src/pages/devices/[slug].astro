---
import Base from '@/layouts/Base.astro';
import FirmwareCard from '@/components/FirmwareCard.astro';
import FirmwareFilter from '@/components/FirmwareFilter.astro';
import QualityBreakdown from '@/components/QualityBreakdown.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Prose from '@/components/Prose.astro';
import DevicePhoto from '@/components/DevicePhoto.astro';
import { CATEGORY_LABELS } from '@/content/schema';
import { compareFirmwaresByQuality, compareText, firmwareUpdated, statusRank, getDevicesWithFirmwares, hostOf, isoDate, plural, type DeviceItem, type FirmwareItem } from '@/lib/catalog';
import { cacheKeyOf } from '@/lib/cache-key';
import { logoCreditLabel, looksLikeSpdx, spdxUrl } from '@/lib/labels';
import { loadMetrics } from '@/lib/repo-metrics';
import { RATINGS, RATING_DESCRIPTIONS, RATING_LABELS, type Rating } from '@/lib/quality';

export async function getStaticPaths() {
  const devices = await getDevicesWithFirmwares();
  return devices.map((device) => {
    const props = { device, related: devices.filter((o) => device.data.related.includes(o.id)) };
    return { params: { slug: device.id }, props, cacheKey: cacheKeyOf(props) };
  });
}

interface Props { device: DeviceItem; related: DeviceItem[] }
const { device, related } = Astro.props;
const { data } = device;
// Quality is the default order everywhere; FirmwareFilter re-sorts on the client.
const ordered = [...device.firmwares].sort(compareFirmwaresByQuality);
const firmwares = ordered.filter((f) => f.data.kind === 'firmware');
const tools = ordered.filter((f) => f.data.kind === 'tool');
// Status order, kept as data-order for FirmwareFilter's Status sort.
const statusOrder = new Map(
  [...device.firmwares]
    .sort((a, b) => statusRank(a.data.status) - statusRank(b.data.status) || compareText(a.data.name, b.data.name))
    .map((f, i) => [f.id, i]),
);
// A device-level score (device `quality.shared_repo` or `quality.score`), shown once in a collapsible block.
const dq = device.quality?.rating ? device.quality : undefined;
// Otherwise a summary of the entries' public ratings (numeric scores stay internal).
const agg = device.quality ? undefined : device.aggregate;
const rated = agg ? RATINGS.filter((r) => agg.ratings[r] > 0) : [];
const ratedCount = rated.reduce((n, r) => n + agg!.ratings[r], 0);
// Rated entries per rating, best first (ordered is already in quality order).
const byRating = Object.fromEntries(
  RATINGS.map((r) => [r, ordered.filter((f) => f.quality.rating === r && !f.quality.hidden)]),
) as Record<Rating, FirmwareItem[]>;
const LIST_MAX = 8;
const showBlock = !!dq || ratedCount > 0;
const fetchedAt = loadMetrics()?.fetchedAt;
// Quality sort key: position in the server's quality order, higher first. The score itself stays internal.
const qualityKey = new Map(ordered.map((f, i) => [f.id, ordered.length - i]));
const none = device.firmwares.length === 0;
// Entries hidden by hide_stale_after_years; only their number is shown here.
const hidden = device.hiddenFirmwares.length;
const image = data.image;
const logo = image ? undefined : device.logo;
const counts = [
  firmwares.length > 0 && plural(firmwares.length, 'custom firmware'),
  tools.length > 0 && plural(tools.length, 'tool'),
].filter(Boolean).join(' and ');
const description = `${data.name} by ${data.manufacturer}: ${
  none ? 'no custom firmware listed yet' : `${counts} listed`
}${data.tagline ? `. ${data.tagline}` : ''}.`;
// Lowercased search text for the firmware filter; matches the haystack FirmwareFilter splits into terms.
const filterText = (f: FirmwareItem) =>
  [f.data.name, f.data.summary, ...f.data.authors.map((a) => a.name), ...f.data.tags].join(' ').toLowerCase();
// Filter and sort keys read by FirmwareFilter.
const itemAttrs = (f: FirmwareItem) => ({
  'data-fw': f.slug,
  'data-kind': f.data.kind,
  'data-status': f.data.status,
  'data-source': f.data.source_status,
  'data-license': f.data.license,
  'data-q': filterText(f),
  'data-name': f.data.name,
  'data-updated': isoDate(firmwareUpdated(f)) ?? '',
  'data-quality': qualityKey.get(f.id),
  'data-order': statusOrder.get(f.id),
  'data-pin': f.pin,
});
---
<Base
  title={`${data.name} (${data.manufacturer})`}
  description={description}
  editPath={`src/content/devices/${device.id}.yaml`}
>
  <Breadcrumb items={[{ label: 'Devices', href: '/' }, { label: CATEGORY_LABELS[data.category], href: `/#cat-${data.category}` }]} />

  {/* The photo sits above the title on narrow screens and in a right-hand column from lg up. */}
  <div class:list={[(image || logo) && 'flex flex-col lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:items-start lg:gap-8']}>
  <header>
    <h1 class="text-2xl">{data.name}</h1>
    <p class="mt-1 text-muted">
      <a href={`/manufacturers/${device.manufacturerSlug}`}>{data.manufacturer}</a>
      <span aria-hidden="true"> · </span>{CATEGORY_LABELS[data.category]}
    </p>
    {/* The tagline repeats the description's opening; show it only when there is no description. */}
    {data.tagline && !data.description && <p class="mt-1">{data.tagline}</p>}
    <Prose text={data.description} class="mt-3 max-w-[68ch]" />

    <dl class="mt-4 grid max-w-[68ch] grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-sm [&_dd]:[overflow-wrap:anywhere]">
      {data.platform && (<><dt class="text-muted">Platform</dt><dd class="mono">{data.platform}</dd></>)}
      {data.stock_firmware && (<><dt class="text-muted">Stock firmware</dt><dd class="mono">{data.stock_firmware}</dd></>)}
      {data.links.manufacturer && (
        <><dt class="text-muted">Manufacturer</dt><dd><a href={data.links.manufacturer} rel="noopener">{hostOf(data.links.manufacturer)}</a></dd></>
      )}
      {data.links.community.length > 0 && (
        <>
          <dt class="text-muted">Community</dt>
          <dd>
            <ul class="flex flex-wrap gap-x-3">
              {data.links.community.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}
            </ul>
          </dd>
        </>
      )}
      {related.length > 0 && (
        <>
          <dt class="text-muted">Related</dt>
          <dd>
            <ul class="flex flex-wrap gap-x-3">
              {related.map((r) => <li><a href={r.url}>{r.data.name}</a></li>)}
            </ul>
          </dd>
        </>
      )}
    </dl>
  </header>

  {image && <DevicePhoto image={image} class="order-first mb-5 lg:order-none lg:mb-0" />}
  {logo && (
    <figure class="mt-5 max-w-[30rem] lg:mt-0">
      <div class="max-w-[200px] overflow-hidden rounded border border-line bg-surface p-3">
        <img
          src={logo.src}
          alt={logo.alt}
          width={logo.width}
          height={logo.height}
          decoding="async"
          data-style="logo"
          data-monochrome={logo.monochrome ? 'true' : undefined}
          class="block h-auto max-h-24 w-full object-contain"
        />
      </div>
      <figcaption class="mt-1.5 text-xs text-muted">
        {logoCreditLabel(logo)},{' '}
        {looksLikeSpdx(logo.license)
          ? <a href={spdxUrl(logo.license)} rel="noopener">{logo.license}</a>
          : logo.license},{' '}
        via <a href={logo.source_url} rel="noopener">{hostOf(logo.source_url)}</a>
      </figcaption>
    </figure>
  )}
  </div>

  {/* Device notes stay in the data but are not shown; the device's quality rating takes their place. */}
  {showBlock && (
    <details class="notes-details mt-6 rounded border border-line-strong bg-surface" data-device-quality>
      <summary class="flex cursor-pointer flex-wrap items-center gap-x-2 gap-y-1 rounded p-3 sm:p-4">
        <span class="notes-chevron" aria-hidden="true"></span>
        <h2 class="text-base">Quality</h2>
        {dq?.rating && <span class="font-semibold" style="color: var(--violet-fg)">{RATING_LABELS[dq.rating]}</span>}
        {!dq && (
          <span class="text-sm">
            {rated.map((r, i) => (
              <>{i > 0 && <span class="text-muted" aria-hidden="true"> · </span>}<span style="color: var(--violet-fg)">{agg!.ratings[r]} {RATING_LABELS[r]}</span></>
            ))}
          </span>
        )}
      </summary>
      <div class="px-3 pb-3 text-sm sm:px-4 sm:pb-4">
        {dq?.rating && <p class="max-w-[68ch] text-muted">{RATING_DESCRIPTIONS[dq.rating]}</p>}
        {dq?.shared && (
          <p class="mt-2 max-w-[68ch]">
            One rating for {dq.shared.members === 1 ? 'the entry' : `the ${dq.shared.members} entries`} in{' '}
            <a href={`https://github.com/${dq.shared.repo}`} rel="noopener">{dq.shared.repo}</a>, rated once for the repo and
            this device's community, because they share both.
          </p>
        )}
        {dq?.override && <p class="mt-2 max-w-[68ch]">Adjusted by hand: {dq.override.reason}</p>}
        {dq?.shared && (
          <div class="mt-3">
            <QualityBreakdown variant="device" quality={dq.shared.quality} links={data.links.community} fetchedAt={fetchedAt} deviceName={data.name} manufacturer={data.manufacturer} />
          </div>
        )}
        {agg && (
          <>
            <p class="max-w-[68ch] text-muted">
              {ratedCount === agg.count
                ? `All ${agg.count} entries have a quality rating.`
                : `${ratedCount} of ${agg.count} entries have a quality rating; the rest have too little data so far.`}
            </p>
            <dl class="mt-3 flex flex-col gap-3">
              {rated.map((r) => (
                <div>
                  <dt><span class="font-medium" style="color: var(--violet-fg)">{RATING_LABELS[r]}</span> <span class="text-muted">{RATING_DESCRIPTIONS[r]}</span></dt>
                  <dd class="mt-1">
                    {byRating[r].slice(0, LIST_MAX).map((f, i) => <>{i > 0 && ', '}<a href={f.url}>{f.data.name}</a></>)}
                    {byRating[r].length > LIST_MAX && <span class="text-muted"> and {byRating[r].length - LIST_MAX} more</span>}
                  </dd>
                </div>
              ))}
            </dl>
          </>
        )}
        {!dq?.shared && <p class="mt-3 text-xs text-muted"><a href="/about/quality#ratings">How ratings work</a>.</p>}
      </div>
    </details>
  )}

  {none && (
    <section class="mt-6" aria-labelledby="fw-h">
      <h2 id="fw-h" class="text-lg">Firmware</h2>
      <p class="mt-2 text-muted">Nothing listed yet. Know of something? See <a href="/about#contribute">how to contribute</a>.</p>
    </section>
  )}

  {device.firmwares.length >= 3 && (
    <div class="mt-8"><FirmwareFilter firmwares={device.firmwares} search={device.firmwares.length >= 8} defaultSort="quality" /></div>
  )}

  {firmwares.length > 0 && (
    <section class="mt-8" aria-labelledby="fw-h" data-fw-section>
      <h2 id="fw-h" class="mb-3 border-b border-line pb-1 text-lg">Firmware <span class="mono text-sm font-normal text-muted" data-fw-count>{firmwares.length}</span></h2>
      <ul class="flex flex-col gap-3">
        {firmwares.map((f) => <li {...itemAttrs(f)}><FirmwareCard firmware={f} /></li>)}
      </ul>
    </section>
  )}

  {tools.length > 0 && (
    <section class="mt-8" aria-labelledby="tools-h" data-fw-section>
      <h2 id="tools-h" class="mb-3 border-b border-line pb-1 text-lg">Tools <span class="mono text-sm font-normal text-muted" data-fw-count>{tools.length}</span></h2>
      <ul class="flex flex-col gap-3">
        {tools.map((f) => <li {...itemAttrs(f)}><FirmwareCard firmware={f} /></li>)}
      </ul>
    </section>
  )}

  {hidden > 0 && (
    <p class="mt-8 text-sm text-muted" data-hidden-count={hidden}>
      {plural(hidden, 'older project')} not shown: dormant or archived, with no release in the last {plural(data.hide_stale_after_years ?? 0, 'year')}.
    </p>
  )}
</Base>
