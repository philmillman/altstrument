---
import Base from '@/layouts/Base.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import SourceBadge from '@/components/SourceBadge.astro';
import LicenseBadge from '@/components/LicenseBadge.astro';
import BrickWarning from '@/components/BrickWarning.astro';
import TagList from '@/components/TagList.astro';
import AuthorList from '@/components/AuthorList.astro';
import VersionTable from '@/components/VersionTable.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Prose from '@/components/Prose.astro';
import FirmwareMedia from '@/components/FirmwareMedia.astro';
import DevicePhoto from '@/components/DevicePhoto.astro';
import { KIND_LABELS, DISTRIBUTION_LABELS } from '@/lib/labels';
import { cacheKeyOf } from '@/lib/cache-key';
import { getDevicesWithFirmwares, githubEditUrl, hostOf, listNames, plural, type DeviceItem, type FirmwareItem } from '@/lib/catalog';

export async function getStaticPaths() {
  const devices = await getDevicesWithFirmwares();
  const byId = new Map(devices.map((d) => [d.id, d]));
  // One page per entry, under its primary device; devices that list it through
  // also_devices link here. Entries hidden as stale still get a page so
  // existing links keep working.
  const page = (device: DeviceItem, hidden: boolean) => (firmware: FirmwareItem) => {
    const props = { device, firmware, hidden, targets: firmware.deviceIds.map((id) => byId.get(id)!) };
    // Keyed on the fields the page renders, not the whole device: hashing every sibling
    // firmware once per page cost more than re-rendering. Reading another device or
    // target field below means adding it here.
    const cacheKey = cacheKeyOf(
      { url: device.url, data: device.data },
      firmware,
      hidden,
      props.targets.map((t) => ({ url: t.url, manufacturerSlug: t.manufacturerSlug, data: t.data })),
    );
    return { params: { device: device.id, fw: firmware.slug }, props, cacheKey };
  };
  return devices.flatMap((device) => [
    ...device.firmwares.filter((f) => f.deviceId === device.id).map(page(device, false)),
    ...device.hiddenFirmwares.filter((f) => f.deviceId === device.id).map(page(device, true)),
  ]);
}

interface Props { device: DeviceItem; firmware: FirmwareItem; hidden: boolean; targets: DeviceItem[] }
const { device, firmware: fw, hidden, targets } = Astro.props;
const d = fw.data;
const links = [
  d.source && { label: 'Source', url: d.source },
  d.homepage && { label: 'Homepage', url: d.homepage },
].filter(Boolean) as { label: string; url: string }[];
const hasMedia = Boolean(d.video || d.image);
// Without its own media, the firmware page borrows the device photo.
const devicePhoto = hasMedia ? undefined : device.data.image;
// Synced entries are corrected upstream (see CONTRIBUTING.md, "Entries fetched at build time").
const edit = d.generated_from
  ? { editUrl: githubEditUrl(d.generated_from), editLabel: 'Edit upstream on GitHub' }
  : { editPath: `src/content/firmwares/${fw.id}.yaml` };
---
<Base title={`${d.name} for ${listNames(targets.map((t) => t.data.name))}`} description={`${d.name}: ${d.summary}`} noindex={hidden} {...edit}>
  <Breadcrumb items={[{ label: 'Devices', href: '/' }, { label: device.data.name, href: device.url }, { label: d.name }]} />
  {hidden && (
    <p class="mb-4 max-w-[68ch] text-sm text-muted">
      Hidden from the <a href={device.url}>{device.data.name}</a> list as inactive: no release in the last {plural(device.data.hide_stale_after_years ?? 0, 'year')}.
    </p>
  )}

  {/* Media sits above the title on narrow screens and in a right-hand column from lg up. */}
  <div class:list={[(hasMedia || devicePhoto) && 'flex flex-col lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:items-start lg:gap-8']}>
  <header>
    <h1 class="text-2xl">{d.name}</h1>
    <p class="mt-1 text-muted">
      {KIND_LABELS[d.kind]} for {targets.map((t, i) => (
        <>{i > 0 && (i === targets.length - 1 ? ' and ' : ', ')}<a href={t.url}>{t.data.name}</a></>
      ))}{' '}
      ({targets.filter((t, i) => targets.findIndex((o) => o.manufacturerSlug === t.manufacturerSlug) === i).map((t, i) => (
        <>{i > 0 && ', '}<a href={`/manufacturers/${t.manufacturerSlug}`}>{t.data.manufacturer}</a></>
      ))})
    </p>
    <p class="mt-2 max-w-[68ch] text-base">{d.summary}</p>
    <p class="mt-2 text-sm text-muted">by <AuthorList authors={d.authors} /></p>
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      <StatusBadge status={d.status} />
      <SourceBadge status={d.source_status} />
      <LicenseBadge license={d.license} />
    </div>
  </header>

  {hasMedia && (
    <div class="order-first mb-5 lg:order-none lg:mb-0">
      <FirmwareMedia video={d.video} videos={d.videos} image={d.image} name={d.name} />
    </div>
  )}
  {devicePhoto && <DevicePhoto image={devicePhoto} class="order-first mb-5 lg:order-none lg:mb-0" />}
  </div>

  {d.brick_risk && <div class="mt-4 max-w-[68ch]"><BrickWarning /></div>}

  <dl class="mt-5 grid max-w-[68ch] grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-sm [&_dd]:[overflow-wrap:anywhere]">
    {d.distribution && (<><dt class="text-muted">Distribution</dt><dd>{DISTRIBUTION_LABELS[d.distribution]}</dd></>)}
    {d.requires_stock && (<><dt class="text-muted">Requires stock</dt><dd class="mono">{d.requires_stock}</dd></>)}
    {d.license_notes && (<><dt class="text-muted">License notes</dt><dd>{d.license_notes}</dd></>)}
    {links.map((l) => (
      <><dt class="text-muted">{l.label}</dt><dd><a href={l.url} rel="noopener">{hostOf(l.url)}</a> <span class="mono break-all text-xs text-muted">{l.url}</span></dd></>
    ))}
    {d.generated_from && (
      <><dt class="text-muted">Synced from</dt><dd>upstream metadata, <a href={d.generated_from} rel="noopener">{hostOf(d.generated_from)}</a> <span class="mono break-all text-xs text-muted">{d.generated_from}</span>. Corrections belong upstream.</dd></>
    )}
  </dl>

  {d.tags.length > 0 && <div class="mt-4"><TagList tags={d.tags} /></div>}

  {d.description && (
    <section class="mt-8" aria-labelledby="desc-h">
      <h2 id="desc-h" class="mb-2 text-lg">Description</h2>
      <Prose text={d.description} />
    </section>
  )}

  {d.install_notes && (
    <section class="mt-8" aria-labelledby="install-h">
      <h2 id="install-h" class="mb-2 text-lg">Install notes</h2>
      <Prose text={d.install_notes} />
    </section>
  )}

  <section class="mt-8" aria-labelledby="versions-h">
    <h2 id="versions-h" class="mb-2 text-lg">Version history</h2>
    {fw.versions.length > 0
      ? <VersionTable versions={fw.versions} visible={1000} anchors caption={`${d.name} version history`} />
      : <p class="text-muted">No versions recorded.</p>}
  </section>

  <p class="mt-8 text-sm"><a href={device.url}>Back to {device.data.name}</a></p>
</Base>
