---
import Base from '@/layouts/Base.astro';
import VersionCard from '@/components/VersionCard.astro';
import { getDevicesWithFirmwares, recentVersions } from '@/lib/catalog';

const rows = recentVersions(await getDevicesWithFirmwares(), 50, { collapseRuns: true });
---
<Base title="Recent versions" description="The most recent dated firmware versions across the catalog.">
  <h1 class="text-2xl">Recent versions</h1>
  <p class="mt-1 max-w-[68ch] text-muted">
    The most recent dated versions across all firmware, newest first. Back-to-back
    versions of the same firmware share a card. Also available as <a href="/feed.xml">RSS</a>.
  </p>
  {rows.length === 0 ? (
    <p class="mt-6 text-muted">No dated versions recorded yet.</p>
  ) : (
    <ol class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3" aria-label="Most recent versions">
      {rows.map((r) => (
        <li><VersionCard row={r} showKind /></li>
      ))}
    </ol>
  )}
</Base>
