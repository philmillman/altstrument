{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site: Workers Builds runs `pnpm run build`, then `wrangler deploy`
  // uploads dist/ as assets. No Worker script, no adapter, no bindings.
  "name": "altstrument",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    // Serve /path from dist/path/index.html without redirecting to /path/, matching
    // Astro's trailingSlash: 'never' and the canonical URLs it emits.
    "html_handling": "drop-trailing-slash"
  },
  "routes": [{ "pattern": "altstrument.org", "custom_domain": true }],
  // Workers Builds runs `wrangler preview` for non-production branches, which
  // needs this block. Empty: the site has no bindings for previews to override.
  "previews": {}
}
